# One database per ORM so each can be created/signed by its own native tooling.
DRIZZLE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bench_drizzle
PRISMA_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bench_prisma
# Admin URL used by scripts/create-dbs.ts (CREATE DATABASE).
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Pool size given to BOTH clients (pg.Pool max / Bun SQL max).
POOL_SIZE=10
